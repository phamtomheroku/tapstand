{"nodes": [{"id": "readme_tapstand", "label": "Tap Stand README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": "phamtomheroku", "contributor": null}, {"id": "readme_nfc_tap_to_review_product", "label": "NFC Tap-to-Review Product Line", "file_type": "concept", "source_file": "README.md", "source_location": "line 3\u20134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_no_review_gating_rule", "label": "No Review Gating Rule", "file_type": "rationale", "source_file": "README.md", "source_location": "line 44\u201346", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tap goes to the public review page. Steering unhappy customers to a private form breaks Google's policy and the FTC's 2024 rule on consumer reviews."}, {"id": "readme_no_google_logo_rule", "label": "No Google Logo Rule", "file_type": "rationale", "source_file": "README.md", "source_location": "line 47\u201348", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Referential use ('Leave us a Google review') is fine, but reproducing the four-colour G on merchandise isn't covered by Google's brand permissions."}, {"id": "readme_server_side_destination", "label": "Server-Side Destination Resolution", "file_type": "rationale", "source_file": "README.md", "source_location": "line 32\u201335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The destination never lives on the tag. Every tag holds one stable URL on your domain, and the server decides where it goes \u2014 so a client can rebrand, move, or switch without the hardware changing. Also why every tag in a batch is identical, enabling same-day activation."}, {"id": "readme_tapcard_sibling", "label": "TapCard (Loyalty Pass Sibling Repo)", "file_type": "concept", "source_file": "README.md", "source_l